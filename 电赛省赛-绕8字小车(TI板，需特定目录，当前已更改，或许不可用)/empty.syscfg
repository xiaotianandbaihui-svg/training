GPIO3.associatedPins[1].$name        = "SDA";
GPIO3.associatedPins[1].ioStructure  = "OD";
GPIO3.associatedPins[1].initialValue = "SET";
GPIO3.associatedPins[1].assignedPin  = "1";

GPIO4.$name                          = "CS";
GPIO4.associatedPins[0].$name        = "PIN_2";
GPIO4.associatedPins[0].assignedPort = "PORTB";
GPIO4.associatedPins[0].assignedPin  = "2";

GPIO5.$name                         = "buzzer";
GPIO5.port                          = "PORTA";
GPIO5.associatedPins[0].assignedPin = "22";
GPIO5.associatedPins[0].$name       = "PIN_22";

GPIO6.$name                         = "xunji";
GPIO6.associatedPins.create(8);
GPIO6.associatedPins[0].$name       = "X1";
GPIO6.associatedPins[0].direction   = "INPUT";
GPIO6.associatedPins[0].pin.$assign = "PA15";
GPIO6.associatedPins[1].$name       = "X2";
GPIO6.associatedPins[1].direction   = "INPUT";
GPIO6.associatedPins[1].pin.$assign = "PA16";
GPIO6.associatedPins[2].$name       = "X3";
GPIO6.associatedPins[2].direction   = "INPUT";
GPIO6.associatedPins[2].pin.$assign = "PA17";
GPIO6.associatedPins[3].$name       = "X4";
GPIO6.associatedPins[3].direction   = "INPUT";
GPIO6.associatedPins[3].pin.$assign = "PA27";
GPIO6.associatedPins[4].$name       = "X5";
